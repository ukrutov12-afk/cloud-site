<%- include('partials/header', { pageTitle: 'Zephyr - 2FA' }) %>

<section class="section narrow">
  <h2 class="section-title"><%= t('twofa.login_title') %></h2>

  <div class="panel" style="max-width:400px;margin:0 auto">
    <p class="muted" style="margin-bottom:16px"><%= t('twofa.login_desc') %></p>
    <form action="/login/2fa" method="post" class="form">
      <label class="field"><span><%= t('twofa.code') %></span>
        <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required maxlength="6" placeholder="000000" autofocus>
      </label>
      <button type="submit" class="btn btn-primary btn-block" style="margin-top:12px"><%= t('twofa.verify') %></button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
