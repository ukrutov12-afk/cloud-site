<%- include('partials/header', { pageTitle: 'Zephyr Client - ' + t('nav.home') }) %>
<%
  var featureIcons = [
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="7.5"></circle><circle cx="12" cy="12" r="2.25"></circle><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3"></path></svg>',
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 18c1.4-5.9 4.2-9.5 8.4-10.8"></path><path d="m11.7 4.8 4.8 1.1-1.1 4.8"></path><circle cx="5" cy="18" r="2"></circle><circle cx="18.5" cy="5.5" r="2"></circle></svg>',
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="3"></rect><path d="M8.5 4v16M8.5 10h12M13 14h3.5M13 17h5"></path></svg>',
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19.2 8.4A8 8 0 1 0 20 14"></path><path d="M19.2 3.8v4.6h-4.6"></path><path d="M12 8v4.4l2.8 1.7"></path></svg>'
  ];
%>

<div class="reference-home">
<section class="ref-hero section-shell" id="top">
  <p class="ref-eyebrow">MINECRAFT 1.21.11 <span>·</span> ZEPHYR CLIENT</p>
  <h1><%= t('refdesign.title') %> <em><%= t('refdesign.accent') %></em></h1>
  <p class="ref-lead"><%= t('refdesign.sub') %></p>
  <div class="ref-actions"><a class="ref-button primary" href="#pricing"><%= t('rebuild.choose') %> ↗</a><a class="ref-button quiet" href="#preview"><%= t('rebuild.look') %></a></div>
  <div class="hero-product"><img src="/img/client-preview.png" alt="<%= t('design.client_screen') %>" width="2048" height="857" fetchpriority="high"></div>
</section>
<section class="hud-section section-shell" id="features">
  <div class="ref-heading"><h2><%= t('refdesign.hud') %> <em><%= t('refdesign.hud_accent') %></em></h2><p><%= t('refdesign.hud_sub') %></p></div>
  <div class="hud-columns"><article><h3><%= t('refdesign.widgets') %></h3><p><%= t('refdesign.widgets_sub') %></p><div class="hud-pills"><% ['binds','armor','totems','media'].forEach(function(key,i){ %><div class="hud-pill"><i><%- featureIcons[i] %></i><span><%= t('refdesign.'+key) %></span></div><% }); %></div></article><article><h3><%= t('refdesign.profiles') %></h3><p><%= t('refdesign.profiles_sub') %></p><div class="hud-pills servers"><% ['FunTime','ReallyWorld','HolyWorld','SpookyTime'].forEach(function(name,i){ %><div class="hud-pill"><i><%- featureIcons[i] %></i><span><%= name %></span></div><% }); %></div></article></div>
  <p class="illustration-note"><%= t('refdesign.sample') %></p>
</section>
<section class="feature-stories section-shell">
  <div class="ref-heading"><h2><%= t('refdesign.client') %> <em><%= t('refdesign.client_accent') %></em></h2><p><%= t('refdesign.client_sub') %></p></div>
  <article class="story-wide"><div class="story-image"><img src="/img/launcher-preview.png" alt="<%= t('design.launcher_screen') %>" width="1280" height="720" loading="lazy"></div><div class="story-copy"><span class="story-kicker">ZEPHYR LAUNCHER</span><h3><%= t('refdesign.launch') %></h3><p><%= t('refdesign.launch_sub') %></p><a class="ref-button quiet" href="<%= user ? '/account' : '/login' %>"><%= t('nav.account') %> ↗</a></div></article>
  <div class="story-pair"><article class="story-tile"><div class="feature-illustration module-illustration" aria-hidden="true"><span class="large-glyph"><%- featureIcons[0] %></span><div class="mini-setting"><%- featureIcons[1] %><span></span><i></i></div><div class="mini-setting"><%- featureIcons[3] %><span></span><i></i></div></div><div class="story-copy"><h3><%= t('rebuild.ft')[0] %></h3><p><%= t('rebuild.fd')[0] %></p></div></article><article class="story-tile"><div class="feature-illustration hud-illustration" aria-hidden="true"><div class="mini-hud"><span><%- featureIcons[2] %>HUD / ZEPHYR</span><div class="hud-bars"><i></i><i></i><i></i><i></i></div><div class="hud-chips"><b><%= t('refdesign.binds') %></b><b><%= t('refdesign.media') %></b></div></div></div><div class="story-copy"><h3><%= t('rebuild.ft')[2] %></h3><p><%= t('rebuild.fd')[2] %></p></div></article></div>
</section>
<section class="ref-gallery section-shell" id="preview" data-carousel aria-label="<%= t('design.preview') %>"><div class="ref-heading"><h2><%= t('refdesign.visual') %> <em><%= t('refdesign.visual_accent') %></em></h2><p><%= t('refdesign.visual_sub') %></p></div><div class="gallery-stage"><div class="media-window" tabindex="0" aria-label="<%= t('design.preview') %>"><figure data-slide><img src="/img/client-preview.png" width="2048" height="857" alt="<%= t('design.client_screen') %>" loading="lazy"><figcaption><strong><%= t('design.client_screen') %></strong><span><%= t('design.development') %></span></figcaption></figure><figure data-slide hidden><img src="/img/launcher-preview.png" width="1280" height="720" alt="<%= t('design.launcher_screen') %>" loading="lazy"><figcaption><strong><%= t('design.launcher_screen') %></strong><span><%= t('design.development') %></span></figcaption></figure></div><div class="gallery-controls"><button type="button" data-carousel-prev aria-label="<%= t('design.previous') %>">‹</button><span data-carousel-count aria-live="polite">01 / 02</span><button type="button" data-carousel-next aria-label="<%= t('design.next') %>">›</button></div></div></section>
<section class="ref-start section-shell" id="start"><div class="ref-heading"><h2><%= t('refdesign.start') %> <em><%= t('refdesign.start_accent') %></em></h2></div><ol><% [0,1,2].forEach(function(i){ %><li><span>0<%= i+1 %></span><h3><%= t('rebuild.st')[i] %></h3><p><%= t('rebuild.sd')[i] %></p></li><% }); %></ol></section>
<section class="ref-pricing section-shell" id="pricing"><div class="ref-heading"><h2><%= t('refdesign.price') %> <em><%= t('refdesign.price_accent') %></em></h2><p><%= t('rebuild.pricing_sub') %></p></div><div class="ref-plans"><% ['month','season','halfyear','lifetime','lifetime_beta'].forEach(function(id){var p=plans[id];var pv=priceView(p.price); %><article class="ref-plan <%= p.popular ? 'is-popular' : '' %>"><div class="ref-plan-top"><h3><%= t('pricing.'+id+'_t') %></h3><% if(p.popular){ %><span><%= t('pricing.most_popular') %></span><% } %></div><div class="ref-price"><strong><%= pv.final.toLocaleString('ru-RU') %> ₽</strong><% if(pv.pct){ %><small><s><%= pv.base.toLocaleString('ru-RU') %> ₽</s> −<%= pv.pct %>%</small><% } %></div><ul><% t('pricing.'+id+'_f').forEach(function(item){ %><li><%= item %></li><% }); %></ul><a class="ref-button <%= p.popular ? 'primary' : 'quiet' %>" href="/buy?plan=<%= id %>"><%= t('pricing.buy_btn') %> ↗</a></article><% }); %></div><a class="trial-link" href="/buy"><%= t('rebuild.trial_cta') %> ↗</a></section>
<section class="ref-faq section-shell" id="faq"><div class="ref-heading"><h2><%= t('support.faq') %></h2><p><%= t('rebuild.faq_sub') %></p></div><div class="faq-list"><% [1,2,3,4].forEach(function(i){ %><div class="faq-item"><button class="faq-question" type="button" aria-expanded="false"><span>0<%= i %></span><b><%= t('support.q'+i) %></b><i aria-hidden="true"></i></button><div class="faq-answer" aria-hidden="true"><div><p><%= t('support.a'+i) %></p></div></div></div><% }); %></div></section>
<section class="ref-help section-shell" id="support"><div><h2><%= t('refdesign.support_title') %></h2><p><%= t('refdesign.support_sub') %></p><a class="ref-button quiet" href="/support"><%= t('rebuild.contact') %> ↗</a></div><div class="help-symbol" aria-hidden="true"><%- featureIcons[3] %></div></section>
<section class="ref-cta section-shell"><h2><%= t('refdesign.ready') %></h2><p><%= t('refdesign.ready_sub') %></p><a class="ref-button" href="/buy"><%= t('rebuild.choose') %> ↗</a></section>
</div>
<%- include('partials/footer') %>
