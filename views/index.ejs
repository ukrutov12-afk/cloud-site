<%- include('partials/header', { pageTitle: 'Zephyr Client - ' + t('nav.home') }) %>
<%
  var featureIcons = [
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="7.5"></circle><circle cx="12" cy="12" r="2.25"></circle><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3"></path></svg>',
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 18c1.4-5.9 4.2-9.5 8.4-10.8"></path><path d="m11.7 4.8 4.8 1.1-1.1 4.8"></path><circle cx="5" cy="18" r="2"></circle><circle cx="18.5" cy="5.5" r="2"></circle></svg>',
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="3"></rect><path d="M8.5 4v16M8.5 10h12M13 14h3.5M13 17h5"></path></svg>',
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19.2 8.4A8 8 0 1 0 20 14"></path><path d="M19.2 3.8v4.6h-4.6"></path><path d="M12 8v4.4l2.8 1.7"></path></svg>'
  ];
%>

<div class="rebuild-home">
<section class="intro-v2 section-shell" id="top">
  <p class="overline"><span class="status-dot"></span><%= t('rebuild.eyebrow') %></p>
  <h1><%= t('rebuild.title1') %><br><span><%= t('rebuild.title2') %></span></h1>
  <div class="intro-bottom"><p><%= t('rebuild.intro') %></p><div class="intro-actions"><a class="v2-button solid" href="#pricing"><%= t('rebuild.choose') %><span>↗</span></a><a class="text-link" href="#preview"><%= t('rebuild.look') %><span>↓</span></a></div></div>
</section>
<section class="showcase-v2 section-shell" id="preview" data-carousel aria-label="<%= t('design.preview') %>">
  <div class="showcase-meta"><span>ZEPHYR / IN-GAME</span><span>MINECRAFT 1.21.11</span></div>
  <div class="media-window" tabindex="0" aria-label="<%= t('design.preview') %>">
    <figure data-slide><img src="/img/client-preview.png" width="2048" height="857" alt="<%= t('design.client_screen') %>" fetchpriority="high"><figcaption><%= t('design.client_screen') %></figcaption></figure>
    <figure data-slide hidden><img src="/img/launcher-preview.png" width="1280" height="720" alt="<%= t('design.launcher_screen') %>" loading="lazy"><figcaption><%= t('design.launcher_screen') %></figcaption></figure>
  </div>
  <div class="showcase-caption"><div><h2><%= t('rebuild.preview') %></h2><p><%= t('rebuild.preview_sub') %></p></div><div class="showcase-controls"><button type="button" data-carousel-prev aria-label="<%= t('design.previous') %>">←</button><span data-carousel-count aria-live="polite">01 / 02</span><button type="button" data-carousel-next aria-label="<%= t('design.next') %>">→</button></div></div>
</section>
<section class="capabilities-v2 section-shell" id="features">
  <div class="chapter"><span>01 / <%= t('features.title') %></span><h2><%= t('rebuild.features') %></h2><p><%= t('rebuild.features_sub') %></p></div>
  <div class="capability-list"><% [0,1,2,3].forEach(function(i){ %>
    <article class="capability"><span class="capability-number">0<%= i+1 %></span><div class="capability-icon"><%- featureIcons[i] %></div><h3><%= t('rebuild.ft')[i] %></h3><p><%= t('rebuild.fd')[i] %></p></article>
  <% }); %></div>
  <div class="server-line"><span><%= t('rebuild.servers') %></span><div><b>FunTime</b><b>ReallyWorld</b><b>HolyWorld</b><b>SpookyTime</b></div></div>
</section>
<section class="setup-v2" id="start"><div class="section-shell setup-inner"><div class="chapter"><span>02 / <%= t('design.start') %></span><h2><%= t('rebuild.start') %></h2><p><%= t('rebuild.start_sub') %></p><a class="text-link" href="<%= user ? '/account' : '/register' %>"><%= user ? t('nav.account') : t('nav.register') %> ↗</a></div><ol class="setup-list"><% [0,1,2].forEach(function(i){ %><li><span>0<%= i+1 %></span><div><h3><%= t('rebuild.st')[i] %></h3><p><%= t('rebuild.sd')[i] %></p></div></li><% }); %></ol></div></section>
<section class="plans-v2 section-shell" id="pricing">
  <div class="chapter"><span>03 / <%= t('pricing.title') %></span><h2><%= t('rebuild.pricing') %></h2><p><%= t('rebuild.pricing_sub') %></p></div>
  <div class="plan-comparison"><div class="comparison-head" aria-hidden="true"><span><%= t('rebuild.duration') %></span><span><%= t('rebuild.included') %></span><span><%= t('rebuild.cost') %></span><span></span></div>
  <% ['month','season','halfyear','lifetime','lifetime_beta'].forEach(function(id){ var p=plans[id];var pv=priceView(p.price); %>
    <article class="comparison-row <%= p.popular ? 'recommended' : '' %>"><div class="comparison-name"><% if(p.popular){ %><span class="recommend-label"><%= t('pricing.most_popular') %></span><% } %><h3><%= t('pricing.'+id+'_t') %></h3><small><%= id==='month' ? '30 '+t('rebuild.days') : id==='season' ? '90 '+t('rebuild.days') : id==='halfyear' ? '180 '+t('rebuild.days') : t('account.forever') %></small></div><ul><% t('pricing.'+id+'_f').forEach(function(item){ %><li><%= item %></li><% }); %></ul><div class="comparison-price"><strong><%= pv.final.toLocaleString('ru-RU') %> ₽</strong><% if(pv.pct){ %><small><s><%= pv.base.toLocaleString('ru-RU') %> ₽</s> <span>−<%= pv.pct %>%</span></small><% } %></div><a class="v2-button <%= p.popular ? 'solid' : '' %>" href="/buy?plan=<%= id %>"><%= t('pricing.buy_btn') %><span>↗</span></a></article>
  <% }); %></div>
  <div class="trial-line"><span><%= t('rebuild.trial') %></span><a class="text-link" href="/buy"><%= t('rebuild.trial_cta') %> ↗</a></div>
</section>
<section class="questions-v2 section-shell" id="faq"><div class="chapter"><span>04 / FAQ</span><h2><%= t('rebuild.faq') %></h2><p><%= t('rebuild.faq_sub') %></p><div class="question-contact"><p><%= t('rebuild.question') %></p><a class="text-link" href="/support"><%= t('rebuild.contact') %> ↗</a></div></div><div class="faq-list"><% [1,2,3,4].forEach(function(i){ %><div class="faq-item"><button class="faq-question" type="button" aria-expanded="false"><span>0<%= i %></span><b><%= t('support.q'+i) %></b><i aria-hidden="true"></i></button><div class="faq-answer" aria-hidden="true"><div><p><%= t('support.a'+i) %></p></div></div></div><% }); %></div></section>
<section class="closing-v2 section-shell" id="support"><img src="/img/zephyr-avatar.jpg" alt="" width="64" height="64"><h2><%= t('rebuild.outro') %><br><span><%= t('rebuild.outro2') %></span></h2><a class="v2-button solid" href="/buy"><%= t('rebuild.choose') %> ↗</a></section>
</div>
<%- include('partials/footer') %>
