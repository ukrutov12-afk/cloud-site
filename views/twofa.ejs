<%- include('partials/header', { pageTitle: 'Zephyr - 2FA' }) %>

<section class="section narrow">
  <h2 class="section-title"><%= t('twofa.title') %></h2>

  <div class="panel" style="max-width:460px;margin:0 auto">
    <% if (enabled) { %>
      <p class="muted"><%= t('twofa.on_desc') %></p>
      <form action="/account/2fa/disable" method="post" class="form" style="margin-top:16px">
        <label class="field"><span><%= t('twofa.code') %></span>
          <input type="text" name="code" inputmode="numeric" autocomplete="off" required maxlength="6" placeholder="000000">
        </label>
        <button type="submit" class="btn btn-primary btn-block" style="margin-top:12px"><%= t('twofa.disable') %></button>
      </form>
    <% } else { %>
      <p class="muted" style="margin-bottom:16px"><%= t('twofa.setup_desc') %></p>
      <div style="text-align:center"><img src="<%= qr %>" alt="QR" style="width:200px;height:200px;border-radius:12px;background:#fff;padding:8px"></div>
      <p class="muted small" style="text-align:center;margin:14px 0 4px"><%= t('twofa.manual') %></p>
      <p class="mono" style="text-align:center;word-break:break-all;user-select:all;letter-spacing:1px"><%= secret %></p>
      <form action="/account/2fa/enable" method="post" class="form" style="margin-top:16px">
        <label class="field"><span><%= t('twofa.code') %></span>
          <input type="text" name="code" inputmode="numeric" autocomplete="off" required maxlength="6" placeholder="000000">
        </label>
        <button type="submit" class="btn btn-primary btn-block" style="margin-top:12px"><%= t('twofa.enable') %></button>
      </form>
    <% } %>
    <a href="/account" class="btn btn-ghost btn-block" style="margin-top:10px"><%= t('account.cancel') %></a>
  </div>
</section>

<%- include('partials/footer') %>
