<%- include('partials/header', { pageTitle: 'Zephyr - ' + t('auth.login_title') }) %>

<section class="auth-page section-shell">
  <div class="auth-story"><span class="overline">ZEPHYR / ACCOUNT</span><h2><%= t('rebuild.auth_title') %></h2><p><%= t('rebuild.auth_text') %></p><img src="/img/client-preview.png" alt="<%= t('design.client_screen') %>"></div>
  <div class="auth-card">
    <span class="auth-kicker"><%= t('nav.account') %></span>
    <h1><%= t('auth.login_title') %></h1>
    <p><%= t('rebuild.auth_note') %></p>
    <form action="/login" method="post" class="auth-form" data-loading-form>
      <label><span><%= t('auth.login_id') %></span><input type="text" name="email" value="<%= form.email || '' %>" required autocomplete="username" autofocus></label>
      <label><span><%= t('auth.password') %></span><input type="password" name="password" required autocomplete="current-password"></label>
      <button type="submit" class="auth-submit"><%= t('auth.login_btn') %><span aria-hidden="true">→</span></button>
    </form>
    <p class="auth-alt"><%= t('auth.no_account') %> <a href="/register"><%= t('auth.or_register') %></a></p>
  </div>
</section>

<%- include('partials/footer') %>
