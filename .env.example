# Скопируйте в .env и подставьте свои значения (или задайте через окружение)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SITE_URL=http://localhost:3000
# длинная случайная строка для подписи сессий — ОБЯЗАТЕЛЬНО смените
SESSION_SECRET=change-me-to-a-long-random-string
# Та же PostgreSQL/Neon база, которая уже подключена к старому сайту
DATABASE_URL=
# Администраторы определяются по email, через запятую
ADMIN_EMAILS=
PURCHASES_FROZEN=true
FROZEN_AT=2026-06-26T00:00:00Z
TELEGRAM_URL=https://t.me/maboycrime
TELEGRAM_NAME=@maboycrime
SUPPORT_URL=https://t.me/maboycrime
SUPPORT_NAME=@maboycrime
SUPPORT_EMAIL=
# Уведомления о запусках лаунчера в Telegram (кто/HWID/UID/время, БЕЗ IP).
# Пусто = выключено. Токен у @BotFather, chat_id у @userinfobot или через getUpdates.
TG_BOT_TOKEN=
TG_CHAT_ID=
# Секрет вебхука бота (setWebhook secret_token). Обязателен на проде.
TG_WEBHOOK_SECRET=
# Кто может нажимать кнопки инцидентов и создавать промокоды (по умолчанию = TG_CHAT_ID)
TG_ADMIN_ID=
# Защита клиента (публичный репо — значения только в env на Render):
# секрет приёма инцидентов от игры (заголовок X-Zephyr-Secret)
ZEPHYR_PROTECT_SECRET=
# каталог подменённых классов для тихого карантина (по умолчанию payload/_quarantine)
ZEPHYR_QUARANTINE_DIR=
